{
  "name": "vue-middleware",
  "version": "2.0.0-alpha",
  "description": "Vue middleware is a powerful Vuejs plugin for creating custom middleware and manage roles and permissions easily.",
  "main": "./dist/vue-middleware.js",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "watch": "tsc -b && vite build --watch --minify false"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.4"
  },
  "module": "./dist/vue-middleware.js",
  "types": "./dist/vue-middleware.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/vue-middleware.d.ts"
      },
      "import": "./dist/vue-middleware.esm.js",
      "require": "./dist/vue-middleware.cjs"
    }
  }
}